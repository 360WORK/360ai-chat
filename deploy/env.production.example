# =============================================================================
# 360AI production .env overlay  (reference — the real file is ../.env)
# =============================================================================
# `deploy/setup.sh` builds ../.env for you:
#   1. copies the repo's .env.example (all upstream defaults), then
#   2. appends the block below with freshly generated secrets, then
#   3. you fill in the 3 values marked  <<< SET THIS >>>.
#
# In a dotenv file the LAST occurrence of a key wins, so this appended block
# overrides whatever the base .env.example set for the same keys.
# You normally do NOT copy this file by hand — it documents what setup.sh writes.
# -----------------------------------------------------------------------------

# --- Where chat is served (the new subdomain) --------------------------------
CHAT_DOMAIN=chat.360ai.com            # <<< SET THIS >>>  (host only, no https://)
ACME_EMAIL=ops@360ai.com              # <<< SET THIS >>>  (Let's Encrypt contact)
DOMAIN_CLIENT=https://chat.360ai.com  # setup.sh derives these from CHAT_DOMAIN
DOMAIN_SERVER=https://chat.360ai.com

# --- Behind the Caddy reverse proxy ------------------------------------------
HOST=0.0.0.0
PORT=3080
TRUST_PROXY=1

# --- Secrets (setup.sh fills these with `openssl rand`; never reuse dev values)
JWT_SECRET=
JWT_REFRESH_SECRET=
CREDS_KEY=
CREDS_IV=
MEILI_MASTER_KEY=

# --- OIDC against the PRODUCTION 360AI provider ------------------------------
# The 360AI Laravel app is the identity provider. Register a production Passport
# client whose redirect URI is  https://<CHAT_DOMAIN>/oauth/openid/callback  and
# add its client id to TRUSTED_CLIENT_IDS on the provider (auto-skips consent).
OPENID_ISSUER=https://360ai.com       # <<< SET THIS >>>  production issuer
OPENID_CLIENT_ID=
OPENID_CLIENT_SECRET=
OPENID_CALLBACK_URL=/oauth/openid/callback
OPENID_SCOPE=openid profile email
OPENID_USE_PKCE=true
OPENID_AUTO_REDIRECT=true
